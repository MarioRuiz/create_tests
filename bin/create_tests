#!/usr/bin/env ruby
require 'optparse'
require 'create_tests'

options = {
  mode: :append
}

optparse = OptionParser.new do |opts|
  opts.banner = "Usage: create_tests [requests_file] [options]\n"
  opts.banner+= "Generate tests from the requests file.\n"
  opts.banner+= "More info: https://github.com/MarioRuiz/create_tests\n\n"
  opts.banner+= "In case no options supplied: \n"
  opts.banner+= "  * It will be adding the tests that are missing if the test file already exists\n"
  
  opts.on("-n", "--dont_overwrite", "In case the test file exists it won't change anything") do
    options[:mode] = :dont_overwrite
  end

  opts.on("-w", "--overwrite", "In case the test file exists it will be overwritten, so the previous content will be deleted") do
    options[:mode] = :overwrite
  end

  opts.on("-a", "--append", "In case the test file exists only missing tests will be appended, existing content is preserved") do
    options[:mode] = :append
  end

  opts.on("-d", "--dry_run", "Preview which files would be created or modified without writing anything") do
    options[:dry_run] = true
  end

  opts.on("--cleanup_each", "Generate cleanup in after(:each) instead of after(:all)") do
    options[:cleanup] = :after_each
  end

  opts.on("--no_cleanup", "Do not generate setup/cleanup hooks") do
    options[:cleanup] = false
  end

  opts.on("--spec_dir DIR", "Output directory for generated test files (default: ./spec, or ./test with --minitest)") do |dir|
    options[:spec_dir] = dir
  end

  opts.on("--settings_dir DIR", "Output directory for generated settings files (default: ./settings)") do |dir|
    options[:settings_dir] = dir
  end

  opts.on("--only KIND", "Generate only these test kinds (repeatable or comma-separated). Kinds: success, auth, required_params, mock, variations, invalid_fields, required_data") do |kind|
    options[:only] ||= []
    options[:only].concat(kind.split(",").map { |s| s.strip.to_sym })
  end

  opts.on("--minitest", "Generate Minitest tests instead of RSpec") do
    options[:test] = :minitest
  end

  opts.on("-v", "--version", "Show version") do
    puts "create_tests #{CreateTests::VERSION}"
    exit
  end

end

optparse.parse!

filename = ARGV.pop
if filename.to_s==''
  puts optparse
  puts "** Need to specify at least a requests file."
else
  CreateTests.from filename, **options
end
